# Optional: copy to ignored .env.full and use --env-file .env.full.
# These are local-demo defaults, not production credentials.
VORTEX_HTTP_PORT=8088
POSTGRES_DB=vortex
POSTGRES_USER=vortex
POSTGRES_PASSWORD=vortex-local
# For a second project alongside host development, choose unused loopback ports.
VORTEX_POSTGRES_PORT=5432
VORTEX_KAFKA_PORT=9092
VORTEX_FULL_SIMULATOR_DELAY=0
VORTEX_FULL_FAILURE_MODE=SUCCESS
