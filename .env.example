# Local-only defaults for host processes and docker compose.
SERVER_PORT=8080
POSTGRES_DB=vortex
POSTGRES_USER=vortex
POSTGRES_PASSWORD=vortex-local
DATABASE_URL=jdbc:postgresql://localhost:5432/vortex?currentSchema=vortex
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Phase 4 installs the business handlers. Disable only for offline inspection.
VORTEX_KAFKA_CONSUMERS_ENABLED=true
VORTEX_COMMAND_TIMEOUT=30s
VORTEX_OBSERVATION_TIMEOUT=30s
VORTEX_TIMEOUT_SWEEP_INTERVAL_MS=1000
VORTEX_SIMULATOR_GROUP=vortex-python-simulator
VORTEX_SIMULATOR_DELAY_SECONDS=0
VORTEX_FAILURE_MODE=SUCCESS
